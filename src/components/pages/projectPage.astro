---
import { Github, ArrowRight, ArrowLeft } from 'lucide-react';
import { projectDetails, type ProjectId } from '../project-details/registry';
import { localize, type Project } from '../../data/projects';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';

interface Props {
  lang: Locale;
  project: Project;
}

const { lang, project } = Astro.props;
const t = useTranslations(lang);
const p = localize(project, lang);
const ProjectComponent = projectDetails[lang][project.slug as ProjectId];
const demoLabel = t.projects.demoLabels[project.links.demoLabel ?? 'demo'];
const backHref = lang === 'pl' ? '/pl/projekty' : '/projects';
const formatDate = (value: string) =>
  new Intl.DateTimeFormat(lang === 'pl' ? 'pl-PL' : 'en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(new Date(`${value}T00:00:00Z`));
---
<main class="relative z-10 max-w-4xl mx-auto px-6 py-12 md:py-20">
  <div class="mb-8">
    <a href={backHref} class="flex items-center gap-2 text-slate-400 hover:text-green-400 transition-colors font-mono text-sm">
      <ArrowLeft size={16} />
      {t.projects.backToProjects}
    </a>
  </div>

  <header class="mb-12 border-b border-slate-800 pb-8">
    <h1 class="text-5xl md:text-6xl font-black text-slate-100 mb-4 tracking-tight">{p.name}</h1>
    <div class="flex items-center justify-between">
      <div class="text-sm font-mono text-slate-400">
        {t.projects.languagesLabel} <span class="text-slate-300">{p.lang}</span>
      </div>
      <div class="flex items-center gap-4">
        {p.links.demo && (
          <a href={p.links.demo} target="_blank" rel="noreferrer" class="flex items-center gap-2 border border-slate-700 text-slate-300 px-4 py-2 font-bold hover:border-green-500 hover:text-green-400 transition-colors rounded-sm text-sm">
            <ArrowRight size={16} /> {demoLabel}
          </a>
        )}
        {p.links.github && (
          <a href={p.links.github} target="_blank" rel="noreferrer"
             class="flex items-center gap-2 bg-slate-800 text-slate-300 px-4 py-2 font-bold hover:bg-green-500/20 hover:text-green-300 transition-colors rounded-sm text-sm">
            <Github size={16} />
            {t.projects.viewOnGithub}
          </a>
        )}
      </div>
    </div>
    <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs text-slate-400">
      <span>{t.projects.published}: <time datetime={p.datePublished}>{formatDate(p.datePublished)}</time></span>
      <span>{t.projects.updated}: <time datetime={p.dateModified}>{formatDate(p.dateModified)}</time></span>
    </div>
  </header>

  {p.screenshot && (
    <figure class="mb-12 aspect-[8/5] w-full overflow-hidden rounded-sm border border-slate-800 bg-slate-950/70 shadow-2xl">
      <picture>
        {p.screenshot.avif && <source srcset={p.screenshot.avif} type="image/avif" />}
        {p.screenshot.webp && <source srcset={p.screenshot.webp} type="image/webp" />}
        <img
          src={p.screenshot.src}
          width={p.screenshot.width ?? 1440}
          height={p.screenshot.height ?? 900}
          alt={p.screenshot.alt}
          loading="eager"
          decoding="async"
          class="block h-full w-full object-contain"
        />
      </picture>
    </figure>
  )}

  <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
    <div class="md:col-span-2">
      {p.links.demo && !p.links.noFreeHostingWarning && (
        <div class="mb-8 p-4 border border-amber-500/30 bg-amber-500/10 rounded-sm text-amber-300 text-sm font-mono leading-relaxed">
          <span class="font-bold">{t.projects.freeHostingWarning.marker}</span> {t.projects.freeHostingWarning.text}
        </div>
      )}

      {p.summary && (
        <section aria-labelledby="project-summary" class="mb-10">
          <h2 id="project-summary" class="mb-4 font-mono text-xs uppercase tracking-[0.18em] text-green-400">{t.projects.summary}</h2>
          <p class="text-lg leading-relaxed text-slate-300">{p.summary}</p>
        </section>
      )}

      <section aria-labelledby="verified-facts" class="mb-10 border-y border-slate-800 py-7">
        <h2 id="verified-facts" class="mb-4 font-mono text-xs uppercase tracking-[0.18em] text-green-400">{t.projects.verifiedFacts}</h2>
        <ul class="list-disc space-y-2 pl-5 text-sm leading-relaxed text-slate-400">
          {p.verifiedFacts.map((fact) => <li>{fact}</li>)}
        </ul>
      </section>

      <aside class="mb-10 border-l-2 border-amber-500/60 pl-4 text-sm leading-relaxed text-slate-400">
        <h2 class="mb-2 font-mono text-xs uppercase tracking-[0.18em] text-amber-300">{t.projects.limitation}</h2>
        <p>{p.limitation}</p>
      </aside>

      {ProjectComponent ? (
        <ProjectComponent />
      ) : (
        <p class="text-slate-400 leading-relaxed">{p.longDescription}</p>
      )}

      <p class="mt-12 border-t border-slate-800 pt-6 font-mono text-sm text-slate-400">
        <span class="mr-3 text-slate-400">{t.projects.verification}:</span>
        <a href={p.verification.url} target="_blank" rel="noreferrer" class="text-green-400 hover:text-green-300 hover:underline">{p.verification.label} ↗</a>
      </p>
    </div>
    <div class="md:col-span-1">
      <h3 class="text-slate-100 font-bold mb-4 flex items-center gap-2 font-mono text-lg tracking-tight">
        {t.projects.technologiesUsed}
      </h3>
      <div class="flex flex-wrap gap-2">
        {p.technologies.map(tech => (
          <span class="bg-slate-900 border border-slate-700 px-3 py-1 text-xs text-slate-300 font-mono rounded">{tech}</span>
        ))}
      </div>
    </div>
  </div>
</main>
