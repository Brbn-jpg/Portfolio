---
/**
 * Body of /privacy, extracted so `src/pages/privacy.astro` can shrink to a
 * thin `<Layout>` delegate.
 *
 * The font-mono SNAKE_CASE section labels below (TL;DR, CONTROLLER, …) are
 * hardcoded English literals, not dictionary keys, on purpose — the plan
 * calls them terminal-style visual signature, not prose, and they stay in
 * English in both locales. `articleRef` strings (the GDPR/RODO citation next
 * to each heading) DO come from the dictionary, because the citation format
 * itself differs by locale (`art. 13(1)(a)` vs `art. 13 ust. 1 lit. a RODO`).
 *
 * §7 (transfers) states each processor's safeguard only as far as it was
 * actually verified: Vercel's DPA incorporates the 2021/914 Standard
 * Contractual Clauses (checked against vercel.com/legal/dpa, rev. 2026-03-17),
 * while Formspree publishes no DPA and names no mechanism in its privacy
 * policy — so the page says exactly that instead of asserting a safeguard that
 * may not exist, and points anyone who cares at the plain email address.
 * If Formspree ever publishes one, this is the paragraph to update.
 */
import { useTranslations } from '../../i18n/utils';
import { PERSON } from '../../consts';
import type { Locale } from '../../i18n/config';
import { ArrowLeft } from 'lucide-react';
import { pathFor } from '../../i18n/routes';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const privacy = t.privacy;
const homeHref = pathFor({ page: 'home' }, lang);
const lastUpdated = '2026-08-01';
---
<main class="relative z-10 max-w-4xl mx-auto px-6 py-12 md:py-20">
  <div class="mb-8">
    <a href={homeHref} class="flex items-center gap-2 text-slate-400 hover:text-green-400 transition-colors font-mono text-sm">
      <ArrowLeft size={16} />
      {privacy.backToHome}
    </a>
  </div>

  <header class="mb-12 border-b border-slate-800 pb-8">
    <h1 class="text-5xl md:text-6xl font-black text-slate-100 mb-4 tracking-tight">{privacy.header.title}</h1>
    <p class="text-slate-500 font-mono text-sm">{privacy.header.lastUpdatedLabel} {lastUpdated}</p>
  </header>

  <div class="space-y-8">

    <section id="tldr">
      <div class="bg-slate-900/50 border border-slate-800 rounded-lg p-8">
        <h2 class="text-3xl font-bold text-slate-100 font-mono tracking-tight mb-4">TL;DR</h2>
        <p class="text-slate-300 leading-relaxed">
          {privacy.tldr.body}
        </p>
      </div>
    </section>

    <section id="controller">
      <div class="bg-slate-900/50 border border-slate-800 rounded-lg p-6">
        <h2 class="text-3xl font-bold text-slate-100 font-mono tracking-tight mb-4">CONTROLLER <span class="text-slate-600 text-sm font-normal">{privacy.controller.articleRef}</span></h2>
        <p class="text-slate-300 leading-relaxed">
          {privacy.controller.introPrefix} {PERSON.name}{privacy.controller.introMiddle} <a href={`mailto:${PERSON.contactEmail}`} class="text-green-400 underline hover:text-green-300">{PERSON.contactEmail}</a>{privacy.controller.introSuffix}
        </p>
        <p class="text-slate-300 leading-relaxed mt-2">
          {privacy.controller.noDpo}
        </p>
      </div>
    </section>

    <section id="what-is-collected">
      <div class="bg-slate-900/50 border border-slate-800 rounded-lg p-6">
        <h2 class="text-3xl font-bold text-slate-100 font-mono tracking-tight mb-4">WHAT_IS_COLLECTED <span class="text-slate-600 text-sm font-normal">{privacy.whatIsCollected.articleRef}</span></h2>
        <p class="text-slate-300 leading-relaxed">
          {privacy.whatIsCollected.ifNoForm}
        </p>
        <p class="text-slate-300 leading-relaxed mt-2">
          {privacy.whatIsCollected.ifForm}
        </p>
      </div>
    </section>

    <section id="why">
      <div class="bg-slate-900/50 border border-slate-800 rounded-lg p-6">
        <h2 class="text-3xl font-bold text-slate-100 font-mono tracking-tight mb-4">WHY <span class="text-slate-600 text-sm font-normal">{privacy.why.articleRef}</span></h2>
        <ul class="list-disc list-inside space-y-1 text-slate-300 leading-relaxed">
          <li>{privacy.why.reasons.reply}</li>
          <li>{privacy.why.reasons.spamFilter}</li>
          <li>{privacy.why.reasons.security}</li>
        </ul>
      </div>
    </section>

    <section id="legal-basis">
      <div class="bg-slate-900/50 border border-slate-800 rounded-lg p-6">
        <h2 class="text-3xl font-bold text-slate-100 font-mono tracking-tight mb-4">LEGAL_BASIS <span class="text-slate-600 text-sm font-normal">{privacy.legalBasis.articleRef}</span></h2>
        <p class="text-slate-300 leading-relaxed">
          {privacy.legalBasis.basisF}
        </p>
        <p class="text-slate-300 leading-relaxed mt-2">
          {privacy.legalBasis.basisB}
        </p>
        <p class="text-slate-300 leading-relaxed mt-2">
          {privacy.legalBasis.noConsent}
        </p>
      </div>
    </section>

    <section id="who-else-sees-it">
      <div class="bg-slate-900/50 border border-slate-800 rounded-lg p-6">
        <h2 class="text-3xl font-bold text-slate-100 font-mono tracking-tight mb-4">WHO_ELSE_SEES_IT <span class="text-slate-600 text-sm font-normal">{privacy.whoElseSeesIt.articleRef}</span></h2>
        <ul class="list-disc list-inside space-y-2 text-slate-300 leading-relaxed">
          <li><span class="font-bold text-slate-200">{privacy.whoElseSeesIt.processors.formspree.name}</span> {privacy.whoElseSeesIt.processors.formspree.description}</li>
          <li><span class="font-bold text-slate-200">{privacy.whoElseSeesIt.processors.google.name}</span> {privacy.whoElseSeesIt.processors.google.description}</li>
          <li><span class="font-bold text-slate-200">{privacy.whoElseSeesIt.processors.vercel.name}</span> {privacy.whoElseSeesIt.processors.vercel.description}</li>
        </ul>
        <p class="text-slate-300 leading-relaxed mt-3">
          {privacy.whoElseSeesIt.noBroker}
        </p>
      </div>
    </section>

    <section id="transfers-outside-eea">
      <div class="bg-slate-900/50 border border-slate-800 rounded-lg p-6">
        <h2 class="text-3xl font-bold text-slate-100 font-mono tracking-tight mb-4">TRANSFERS_OUTSIDE_EEA <span class="text-slate-600 text-sm font-normal">{privacy.transfersOutsideEea.articleRef}</span></h2>
        <p class="text-slate-300 leading-relaxed">
          {privacy.transfersOutsideEea.intro}
        </p>
        <p class="mt-3 text-slate-300 leading-relaxed">
          {privacy.transfersOutsideEea.vercel}
        </p>
        <p class="mt-3 text-slate-300 leading-relaxed">
          {privacy.transfersOutsideEea.formspree}
        </p>
      </div>
    </section>

    <section id="how-long">
      <div class="bg-slate-900/50 border border-slate-800 rounded-lg p-6">
        <h2 class="text-3xl font-bold text-slate-100 font-mono tracking-tight mb-4">HOW_LONG <span class="text-slate-600 text-sm font-normal">{privacy.howLong.articleRef}</span></h2>
        <p class="text-slate-300 leading-relaxed">
          {privacy.howLong.formMessages}
        </p>
        <p class="mt-3 text-slate-300 leading-relaxed">
          {privacy.howLong.logs}
        </p>
      </div>
    </section>

    <section id="your-rights">
      <div class="bg-slate-900/50 border border-slate-800 rounded-lg p-6">
        <h2 class="text-3xl font-bold text-slate-100 font-mono tracking-tight mb-4">YOUR_RIGHTS <span class="text-slate-600 text-sm font-normal">{privacy.yourRights.articleRef}</span></h2>
        <p class="text-slate-300 leading-relaxed">
          {privacy.yourRights.listedRights}
        </p>
        <p class="text-slate-300 leading-relaxed mt-2">
          {privacy.yourRights.objectionBefore} <span class="font-bold text-slate-200">{privacy.yourRights.objectionBold}</span> {privacy.yourRights.objectionAfter}
        </p>
        <p class="text-slate-300 leading-relaxed mt-2">
          {privacy.yourRights.contactBeforeEmail} <a href={`mailto:${PERSON.contactEmail}`} class="text-green-400 underline hover:text-green-300">{PERSON.contactEmail}</a> {privacy.yourRights.contactAfterEmail} <a href="https://uodo.gov.pl" target="_blank" rel="noreferrer" class="text-green-400 underline hover:text-green-300">uodo.gov.pl</a>.
        </p>
      </div>
    </section>

    <section id="voluntary">
      <div class="bg-slate-900/50 border border-slate-800 rounded-lg p-6">
        <h2 class="text-3xl font-bold text-slate-100 font-mono tracking-tight mb-4">VOLUNTARY <span class="text-slate-600 text-sm font-normal">{privacy.voluntary.articleRef}</span></h2>
        <p class="text-slate-300 leading-relaxed">
          {privacy.voluntary.body}
        </p>
      </div>
    </section>

    <section id="no-automated-decisions">
      <div class="bg-slate-900/50 border border-slate-800 rounded-lg p-6">
        <h2 class="text-3xl font-bold text-slate-100 font-mono tracking-tight mb-4">NO_AUTOMATED_DECISIONS <span class="text-slate-600 text-sm font-normal">{privacy.noAutomatedDecisions.articleRef}</span></h2>
        <p class="text-slate-300 leading-relaxed">
          {privacy.noAutomatedDecisions.body}
        </p>
      </div>
    </section>

    <section id="cookies-and-local-storage">
      <div class="bg-slate-900/50 border border-slate-800 rounded-lg p-6">
        <h2 class="text-3xl font-bold text-slate-100 font-mono tracking-tight mb-4">COOKIES_AND_LOCAL_STORAGE <span class="text-slate-600 text-sm font-normal">{privacy.cookiesAndLocalStorage.articleRef}</span></h2>
        <p class="text-slate-300 leading-relaxed">
          {privacy.cookiesAndLocalStorage.cookies}
        </p>
        <p class="text-slate-300 leading-relaxed mt-2">
          {privacy.cookiesAndLocalStorage.storageBeforeLocal} <code class="font-mono text-slate-200 bg-slate-800 px-1 rounded">localStorage</code> {privacy.cookiesAndLocalStorage.storageBetween} <code class="font-mono text-slate-200 bg-slate-800 px-1 rounded">sessionStorage</code>{privacy.cookiesAndLocalStorage.storageAfter}
        </p>
      </div>
    </section>

    <section id="third-party-requests">
      <div class="bg-slate-900/50 border border-slate-800 rounded-lg p-6">
        <h2 class="text-3xl font-bold text-slate-100 font-mono tracking-tight mb-4">THIRD_PARTY_REQUESTS <span class="text-slate-600 text-sm font-normal">{privacy.thirdPartyRequests.articleRef}</span></h2>
        <p class="text-slate-300 leading-relaxed">
          {privacy.thirdPartyRequests.noRequests}
        </p>
        <p class="text-slate-300 leading-relaxed mt-2">
          {privacy.thirdPartyRequests.githubBuildTime}
        </p>
        <p class="text-slate-300 leading-relaxed mt-2">
          {privacy.thirdPartyRequests.formOnly}
        </p>
      </div>
    </section>

    <section id="external-links">
      <div class="bg-slate-900/50 border border-slate-800 rounded-lg p-6">
        <h2 class="text-3xl font-bold text-slate-100 font-mono tracking-tight mb-4">EXTERNAL_LINKS</h2>
        <p class="text-slate-300 leading-relaxed">
          {privacy.externalLinks.body}
        </p>
      </div>
    </section>

    <section id="changes">
      <div class="bg-slate-900/50 border border-slate-800 rounded-lg p-6">
        <h2 class="text-3xl font-bold text-slate-100 font-mono tracking-tight mb-4">CHANGES</h2>
        <p class="text-slate-300 leading-relaxed">
          {privacy.changes.body}
        </p>
      </div>
    </section>

  </div>
</main>
