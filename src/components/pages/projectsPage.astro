---
import { ArrowUpRight, Github, Server } from "lucide-react";
import ProjectCard from "../projectCard.astro";
import { allProjects, localize } from "../../data/projects";
import type { Locale } from "../../i18n/config";
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const copy = t.projects.index;
---

<main class="relative z-10 mx-auto max-w-5xl px-6 py-12 md:py-20">
  <header class="mb-14 max-w-3xl border-b border-slate-800 pb-10 md:mb-16">
    <p class="mb-4 font-mono text-xs uppercase tracking-[0.18em] text-green-400">{copy.eyebrow}</p>
    <h1 class="text-4xl font-black tracking-tight text-slate-100 md:text-6xl">{copy.title}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-400 md:text-xl">{copy.intro}</p>
  </header>

  <section aria-labelledby="projects-heading">
    <div class="mb-8 flex items-center gap-3 border-b border-slate-800 pb-3">
      <Server className="text-green-500" size={23} aria-hidden="true" />
      <h2 id="projects-heading" class="font-mono text-2xl font-bold tracking-tight text-slate-100">
        {t.common.navigation.projects}
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      {allProjects.map((project) => <ProjectCard project={localize(project, lang)} lang={lang} />)}
    </div>
  </section>

  <section class="mt-12 border-t border-slate-800 pt-8 md:mt-16" aria-label={copy.githubCta}>
    <a
      href="https://github.com/Brbn-jpg"
      target="_blank"
      rel="noreferrer"
      class="group flex items-center justify-between gap-4 border border-dashed border-slate-800 p-5 transition-colors hover:border-green-500/60 focus-visible:outline focus-visible:outline-1 focus-visible:outline-green-400"
    >
      <span class="flex items-center gap-3">
        <Github size={22} className="text-green-400" aria-hidden="true" />
        <span>
          <span class="block font-mono text-sm text-slate-200">{copy.githubCta}</span>
          <span class="mt-1 block text-sm text-slate-400">{copy.githubDescription}</span>
        </span>
      </span>
      <ArrowUpRight size={18} className="shrink-0 text-slate-400 transition-colors group-hover:text-green-400" aria-hidden="true" />
    </a>
  </section>
</main>
