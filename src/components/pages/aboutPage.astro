---
import { Image, getImage } from "astro:assets";
import { ArrowLeft, Bike, Brain, Dumbbell, X } from "lucide-react";
import { useTranslations } from "../../i18n/utils";
import { pathFor } from "../../i18n/routes";
import type { Locale } from "../../i18n/config";
import bike from "../../assets/about/bike.png";
import fullSetup from "../../assets/about/fullSetup.jpg";
import pc from "../../assets/about/pc.png";
import mnk from "../../assets/about/mnk.png";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const about = t.about;
const homeHref = pathFor({ page: "home" }, lang);

const fullSetupFull = (await getImage({ src: fullSetup, width: 1600, format: "webp", quality: 78 })).src;
const pcFull = (await getImage({ src: pc, width: 1600, format: "webp", quality: 78 })).src;
const mnkFull = (await getImage({ src: mnk, width: 1600, format: "webp", quality: 78 })).src;
---

<main class="relative z-10 mx-auto max-w-5xl px-6 py-12 md:py-20">
  <div class="mb-10">
    <a href={homeHref} class="inline-flex items-center gap-2 font-mono text-sm text-slate-400 transition-colors hover:text-green-400 focus-visible:outline focus-visible:outline-1 focus-visible:outline-green-400">
      <ArrowLeft size={16} aria-hidden="true" />
      {about.backToHome}
    </a>
  </div>

  <header class="mb-14 border-b border-slate-800 pb-8">
    <p class="mb-4 font-mono text-xs uppercase tracking-[0.18em] text-green-400">/ about</p>
    <h1 class="text-5xl font-black tracking-tight text-slate-100 md:text-6xl">{about.header.title}</h1>
    <p class="mt-4 max-w-2xl text-xl text-slate-400">{about.header.subtitle}</p>
  </header>

  <section id="about-me-intro" class="scroll-mt-24 pb-16 md:pb-20">
    <div class="max-w-3xl">
      <h2 class="mb-6 font-mono text-2xl font-bold tracking-tight text-slate-100">{about.whoIAm.heading}</h2>
      <div class="space-y-4 text-lg leading-relaxed text-slate-300">
        {about.whoIAm.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section id="focus" class="scroll-mt-24 border-t border-slate-800 py-16 md:py-20">
    <div class="mb-8 flex items-center gap-3">
      <span class="font-mono text-green-500" aria-hidden="true">#</span>
      <h2 class="font-mono text-2xl font-bold tracking-tight text-slate-100">{about.focus.heading}</h2>
    </div>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {about.focus.items.map((item, index) => (
        <article class="border border-slate-800 bg-slate-900/35 p-5">
          <p class="mb-5 font-mono text-xs text-green-400">0{index + 1}</p>
          <h3 class="mb-2 text-lg font-bold text-slate-100">{item.title}</h3>
          <p class="text-sm leading-relaxed text-slate-400">{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="journey" class="scroll-mt-24 border-t border-slate-800 py-16 md:py-20">
    <div class="mb-8 flex items-center gap-3">
      <span class="font-mono text-green-500" aria-hidden="true">#</span>
      <h2 class="font-mono text-2xl font-bold tracking-tight text-slate-100">{about.journey.heading}</h2>
    </div>
    <ol class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {about.journey.entries.map((entry, index) => (
        <li class="border-t border-green-500/50 pt-4">
          <p class="mb-3 font-mono text-xs text-green-400">0{index + 1}</p>
          <h3 class="mb-2 text-lg font-bold text-slate-100">{entry.title}</h3>
          <p class="text-sm leading-relaxed text-slate-400">{entry.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="interests" class="scroll-mt-24 border-t border-slate-800 py-16 md:py-20">
    <div class="mb-8 flex items-center gap-3">
      <span class="font-mono text-green-500" aria-hidden="true">#</span>
      <h2 class="font-mono text-2xl font-bold tracking-tight text-slate-100">{about.interests.heading}</h2>
    </div>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      <article class="border border-slate-800 bg-slate-900/35 p-5">
        <div class="mb-4 flex items-center gap-3">
          <Brain size={21} className="text-purple-400" aria-hidden="true" />
          <h3 class="font-bold text-slate-100">{about.interests.cards.ragLlm.title}</h3>
        </div>
        <p class="text-sm leading-relaxed text-slate-400">{about.interests.cards.ragLlm.body}</p>
      </article>
      <article class="flex flex-col border border-slate-800 bg-slate-900/35 p-5">
        <div class="mb-4 flex items-center gap-3">
          <Bike size={21} className="text-orange-400" aria-hidden="true" />
          <h3 class="font-bold text-slate-100">{about.interests.cards.cycling.title}</h3>
        </div>
        <p class="text-sm leading-relaxed text-slate-400">{about.interests.cards.cycling.body}</p>
        <Image src={bike} alt={about.interests.bikeAlt} width={200} height={96} class="mt-5 h-24 w-full object-contain" loading="lazy" />
      </article>
      <article class="border border-slate-800 bg-slate-900/35 p-5">
        <div class="mb-4 flex items-center gap-3">
          <Dumbbell size={21} className="text-red-400" aria-hidden="true" />
          <h3 class="font-bold text-slate-100">{about.interests.cards.gym.title}</h3>
        </div>
        <p class="text-sm leading-relaxed text-slate-400">{about.interests.cards.gym.body}</p>
      </article>
    </div>
  </section>

  <section id="my-setup" class="scroll-mt-24 border-t border-slate-800 py-16 md:py-20">
    <div class="mb-8 flex items-center gap-3">
      <span class="font-mono text-green-500" aria-hidden="true">#</span>
      <h2 class="font-mono text-2xl font-bold tracking-tight text-slate-100">{about.mySetup.heading}</h2>
    </div>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      <button type="button" class="gallery-trigger group text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400" data-full={fullSetupFull} aria-label={about.mySetup.imageAlts.fullSetup}>
        <Image src={fullSetup} alt={about.mySetup.imageAlts.fullSetup} widths={[400, 800, 1200]} sizes="(min-width: 768px) 33vw, 100vw" format="webp" quality={72} class="h-56 w-full rounded-sm border border-slate-800 object-cover transition-colors group-hover:border-green-500" loading="lazy" decoding="async" />
      </button>
      <button type="button" class="gallery-trigger group text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400" data-full={pcFull} aria-label={about.mySetup.imageAlts.pc}>
        <Image src={pc} alt={about.mySetup.imageAlts.pc} widths={[400, 800, 1200]} sizes="(min-width: 768px) 33vw, 100vw" format="webp" quality={72} class="h-56 w-full rounded-sm border border-slate-800 object-cover transition-colors group-hover:border-green-500" loading="lazy" decoding="async" />
      </button>
      <button type="button" class="gallery-trigger group text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400" data-full={mnkFull} aria-label={about.mySetup.imageAlts.mnk}>
        <Image src={mnk} alt={about.mySetup.imageAlts.mnk} widths={[400, 800, 1200]} sizes="(min-width: 768px) 33vw, 100vw" format="webp" quality={72} class="h-56 w-full rounded-sm border border-slate-800 object-cover transition-colors group-hover:border-green-500" loading="lazy" decoding="async" />
      </button>
    </div>
  </section>

  <details id="gear-list" class="scroll-mt-24 border-t border-slate-800 py-6">
    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-mono text-lg font-bold text-slate-300 transition-colors hover:text-green-400 focus-visible:outline focus-visible:outline-1 focus-visible:outline-green-400">
      <span>{about.gearList.heading}</span>
      <span class="text-green-400" aria-hidden="true">+</span>
    </summary>
    <div class="grid grid-cols-1 gap-8 pt-8 font-mono text-sm text-slate-400 md:grid-cols-2">
      <div>
        <h3 class="mb-3 border-b border-slate-700 pb-2 text-base font-bold text-slate-200">{about.gearList.pcHeading}</h3>
        <ul class="space-y-1">
          <li><span class="font-bold text-slate-300">{about.gearList.labels.cpu}:</span> Ryzen 7 5800X3D</li>
          <li><span class="font-bold text-slate-300">{about.gearList.labels.ram}:</span> 32GB Trident Z 3200Mhz</li>
          <li><span class="font-bold text-slate-300">{about.gearList.labels.mobo}:</span> B450 Gigabyte Aorus Elite</li>
          <li><span class="font-bold text-slate-300">{about.gearList.labels.gpu}:</span> RTX 4070 Super Aorus Master</li>
          <li><span class="font-bold text-slate-300">{about.gearList.labels.ssd1}:</span> Patriot P400 Lite 1TB</li>
          <li><span class="font-bold text-slate-300">{about.gearList.labels.ssd2}:</span> Lexar NM620 2TB</li>
          <li><span class="font-bold text-slate-300">{about.gearList.labels.case}:</span> NZXT H7 Flow</li>
          <li><span class="font-bold text-slate-300">{about.gearList.labels.cooler}:</span> Arctic Liquid Freezer III 360mm</li>
        </ul>
      </div>
      <div>
        <h3 class="mb-3 border-b border-slate-700 pb-2 text-base font-bold text-slate-200">{about.gearList.peripheralsHeading}</h3>
        <ul class="space-y-1">
          <li><span class="font-bold text-slate-300">{about.gearList.labels.keyboard}:</span> Custom (Case 5075 VIA, Akko Botany switches, BoW Keycaps)</li>
          <li><span class="font-bold text-slate-300">{about.gearList.labels.mouse}:</span> Dark Project Nexus</li>
          <li><span class="font-bold text-slate-300">{about.gearList.labels.monitors}:</span> Alienware AW3425DW &amp; PL2470HS</li>
          <li><span class="font-bold text-slate-300">{about.gearList.labels.microphone}:</span> Novox NC1</li>
          <li><span class="font-bold text-slate-300">{about.gearList.labels.headphones}:</span> Arctis 7 &amp; Airpods 2 Pro</li>
        </ul>
      </div>
      <div class="md:col-span-2">
        <h3 class="mb-3 border-b border-slate-700 pb-2 text-base font-bold text-slate-200">{about.gearList.laptopHeading}</h3>
        <p>Macbook Pro 14&quot; (M1 Pro, 10c CPU, 16c GPU, 16GB RAM, 1TB SSD)</p>
      </div>
    </div>
  </details>
</main>

<div id="lightbox" class="fixed inset-0 z-50 hidden place-items-center bg-slate-950/90 p-4 opacity-0 transition-opacity duration-300" role="dialog" aria-modal="true" aria-label={about.mySetup.heading}>
  <button id="lightbox-close" type="button" class="absolute right-6 top-6 z-50 text-slate-400 transition-colors hover:text-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-green-400" aria-label={about.mySetup.lightboxClose}>
    <X size={32} aria-hidden="true" />
  </button>
  <img id="lightbox-img" alt="" class="max-h-[85vh] max-w-[90vw] rounded-sm object-contain shadow-2xl" />
</div>

<script>
  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement | null;
  const lightboxClose = document.getElementById("lightbox-close");
  const galleryTriggers = document.querySelectorAll<HTMLButtonElement>(".gallery-trigger");
  let previousFocus: HTMLButtonElement | null = null;

  const closeLightbox = () => {
    if (!lightbox || !lightboxImg) return;
    lightbox.classList.add("opacity-0");
    window.setTimeout(() => {
      lightbox.classList.add("hidden");
      lightboxImg.removeAttribute("src");
      lightboxImg.setAttribute("alt", "");
    }, 300);
    previousFocus?.focus();
  };

  galleryTriggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const full = trigger.dataset.full;
      const image = trigger.querySelector("img");
      if (!lightbox || !lightboxImg || !full) return;
      previousFocus = trigger;
      lightboxImg.src = full;
      lightboxImg.alt = image?.alt ?? "";
      lightbox.classList.remove("hidden");
      window.setTimeout(() => lightbox.classList.remove("opacity-0"), 10);
      lightboxClose?.focus();
    });
  });

  lightboxClose?.addEventListener("click", closeLightbox);
  lightbox?.addEventListener("click", (event) => {
    if (event.target === lightbox) closeLightbox();
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && lightbox && !lightbox.classList.contains("hidden")) closeLightbox();
  });
</script>
