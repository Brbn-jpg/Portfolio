---
import { ArrowRight, Briefcase, Github, Server } from "lucide-react";
import ContactForm from "../ContactForm.jsx";
import GlitchText from "../glitchText.astro";
import ProjectCard from "../projectCard.astro";
import { allProjects, localize } from "../../data/projects";
import { localizeExperience } from "../../data/experience";
import { pathFor } from "../../i18n/routes";
import { useTranslations } from "../../i18n/utils";
import type { Locale } from "../../i18n/config";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = t.home;
const experience = localizeExperience(lang);
const aboutHref = pathFor({ page: "about" }, lang);
const privacyHref = pathFor({ page: "privacy" }, lang);
const highlights = [
  home.highlights.items.todrawn,
  home.highlights.items.rag,
  home.highlights.items.llama,
];
---

<main class="relative z-10 mx-auto max-w-5xl px-6 py-12 md:py-20">
  <header class="flex min-h-[58dvh] flex-col justify-center py-16 md:min-h-[62dvh]">
    <div class="mb-8">
      <div class="mb-5 inline-flex items-center rounded-sm border border-green-500/30 bg-green-500/10 px-3 py-1 font-mono text-xs text-green-400">
        {home.statusPill}
      </div>
      <p class="mb-3 font-mono text-sm text-green-400" aria-hidden="true">{home.whoamiPrompt}</p>
      <h1 class="max-w-4xl text-5xl font-black tracking-tight text-slate-100 md:text-7xl">
        JAKUB <GlitchText text="KUŹNICKI" />
      </h1>
      <p class="mt-5 font-mono text-sm text-slate-400">
        {home.tagline.prefix} <span class="text-green-400">brbn-jpg</span> · {home.tagline.role} · {home.tagline.location}
      </p>
    </div>

    <p class="mb-8 max-w-2xl text-xl leading-relaxed text-slate-300 md:text-2xl">
      {home.heroParagraph.map((part) =>
        part.highlight ? <span class="font-bold text-green-400">{part.text}</span> : part.text
      )}
    </p>

    <div class="flex flex-wrap items-center gap-3 font-mono text-sm">
      <a
        href="#projects"
        class="inline-flex items-center gap-2 rounded-sm bg-green-600 px-5 py-3 font-bold text-slate-950 transition-colors hover:bg-green-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-400"
      >
        {home.heroCtas.projects}
        <ArrowRight size={16} />
      </a>
      <a
        href="#contact"
        class="inline-flex items-center gap-2 rounded-sm border border-slate-700 px-5 py-3 text-slate-300 transition-colors hover:border-green-500 hover:text-green-400 focus-visible:outline focus-visible:outline-1 focus-visible:outline-green-400"
      >
        {home.heroCtas.contact}
      </a>
      <a
        href={aboutHref}
        class="inline-flex items-center gap-2 rounded-sm px-3 py-3 text-slate-500 transition-colors hover:text-green-400 focus-visible:outline focus-visible:outline-1 focus-visible:outline-green-400"
      >
        {home.heroCtas.about}
      </a>
    </div>
  </header>

  <section id="highlights" class="scroll-mt-24 border-y border-slate-800 py-12 md:py-16">
    <div class="mb-8 max-w-2xl">
      <p class="mb-3 font-mono text-xs uppercase tracking-[0.18em] text-green-400">{home.chrome.evidence}</p>
      <h2 class="text-3xl font-bold tracking-tight text-slate-100">{home.highlights.heading}</h2>
      <p class="mt-3 text-slate-400">{home.highlights.lead}</p>
    </div>
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {highlights.map((item) => (
        <article class="border border-slate-800 bg-slate-900/40 p-5 transition-colors hover:border-green-500/50">
          <p class="mb-6 font-mono text-[11px] uppercase tracking-[0.14em] text-green-400">{item.label}</p>
          <h3 class="mb-2 text-lg font-bold text-slate-100">{item.title}</h3>
          <p class="text-sm leading-relaxed text-slate-400">{item.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="experience" class="scroll-mt-24 py-16 md:py-20">
    <div class="mb-8 flex items-center gap-3 border-b border-slate-800 pb-3">
      <Briefcase className="text-green-500" size={23} aria-hidden="true" />
      <h2 class="font-mono text-2xl font-bold tracking-tight text-slate-100">{home.sections.professionalExp.heading}</h2>
    </div>
    <p class="mb-8 max-w-2xl leading-relaxed text-slate-400">{home.sections.professionalExp.lead}</p>
    <div class="space-y-5">
      {experience.map((exp) => (
        <article class="border border-slate-800 bg-slate-900/30 p-5 md:p-6">
          <div class="flex flex-col gap-2 md:flex-row md:items-start md:justify-between">
            <div>
              <h3 class="text-lg font-bold text-slate-100">{exp.role}</h3>
              <p class="mt-1 font-mono text-sm text-green-500">{exp.company}</p>
            </div>
            <span class="w-fit border border-slate-800 bg-slate-900 px-2 py-1 font-mono text-xs text-slate-500">{exp.period}</span>
          </div>
          <p class="mt-4 max-w-3xl text-sm leading-relaxed text-slate-400">{exp.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="projects" class="scroll-mt-24 pb-16 md:pb-20">
    <div class="mb-8 flex items-center gap-3 border-b border-slate-800 pb-3">
      <Server className="text-green-500" size={23} aria-hidden="true" />
      <h2 class="font-mono text-2xl font-bold tracking-tight text-slate-100">{home.sections.repositories.heading}</h2>
    </div>
    <p class="mb-8 max-w-2xl leading-relaxed text-slate-400">{home.sections.repositories.lead}</p>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      {allProjects.map((project) => <ProjectCard project={localize(project, lang)} lang={lang} />)}
      <a
        href="https://github.com/Brbn-jpg"
        target="_blank"
        rel="noreferrer"
        class="flex min-h-28 items-center justify-center gap-3 border border-dashed border-slate-800 p-5 font-mono text-sm text-slate-500 transition-colors hover:border-slate-600 hover:text-slate-300 focus-visible:outline focus-visible:outline-1 focus-visible:outline-green-400"
      >
        <Github size={22} aria-hidden="true" />
        {home.checkGithubForMore}
      </a>
    </div>
  </section>

  <section id="contact" class="scroll-mt-24 border-t border-slate-800 py-16 md:py-20">
    <div class="grid gap-10 md:grid-cols-[1fr_auto] md:items-start">
      <div class="max-w-xl">
        <p class="mb-3 font-mono text-xs uppercase tracking-[0.18em] text-green-400">{home.chrome.openChannel}</p>
        <h2 class="font-mono text-3xl font-bold tracking-tight text-slate-100">{home.contact.heading}</h2>
        <p class="mt-4 leading-relaxed text-slate-400">{home.contact.lead}</p>
      </div>
      <ContactForm client:idle formspreeId="xgvddwnz" locale={lang} privacyHref={privacyHref} t={t.contact} />
    </div>
  </section>
</main>
