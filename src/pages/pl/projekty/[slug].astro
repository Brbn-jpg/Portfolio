---
import { allProjects, localize } from '../../../data/projects';
import Layout from '../../../layouts/layout.astro';
import ProjectPage from '../../../components/pages/projectPage.astro';
import { SITE_URL } from '../../../consts';
import { absUrl, pathFor } from '../../../i18n/routes';
import { useTranslations } from '../../../i18n/utils';

export async function getStaticPaths() {
  return allProjects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const lang = 'pl' as const;
const t = useTranslations(lang);
const localized = localize(project, lang);

const PERSON_ID = `${SITE_URL}/#person`;
const WEBSITE_ID = `${SITE_URL}/#website`;

/**
 * EN canonical, fixed regardless of which locale is rendering this page: one
 * software artefact, described by two documents. `pathFor` is forced to "en"
 * here on purpose — this is the one place a locale-agnostic id is needed.
 */
const projectId = `${absUrl(pathFor({ page: 'project', project }, 'en'))}#project`;

const pageCanonical = absUrl(pathFor({ page: 'project', project }, lang));
const webpageId = `${pageCanonical}#webpage`;
const projectImage = absUrl(project.screenshot?.src ?? project.ogImage.src);

/**
 * The middle breadcrumb rung points at the complete Polish project index. The
 * last item has no `item`: it is the current page. Rung names come from the
 * locale dictionary so the visible and structured labels stay aligned.
 */
const breadcrumbNode = {
  '@type': 'BreadcrumbList',
  '@id': `${pageCanonical}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.projects.breadcrumb.home, item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: t.projects.breadcrumb.projects, item: absUrl('/pl/projekty') },
    { '@type': 'ListItem', position: 3, name: project.name },
  ],
};

/**
 * Backend language is the deciding signal for `runtimePlatform`, read straight
 * off `technologies` (already-reviewed data) rather than a new per-project
 * field: every `SoftwareSourceCode` project here is either JVM-based or a
 * Node.js/Astro site.
 */
const runtimePlatform = project.technologies.some((tech) => tech.startsWith('Java')) ? 'JVM' : 'Node.js';

/**
 * No `offers`/`aggregateRating` — inventing a price or rating is fabrication
 * and a manual-action risk. `todrawn` has real Stripe pricing, but the exact
 * numbers aren't known here, so it's omitted rather than guessed.
 */
const projectNode = {
  '@type': project.schemaType,
  '@id': projectId,
  name: project.name,
  description: localized.description,
  inLanguage: lang,
  datePublished: project.datePublished,
  dateModified: project.dateModified,
  image: projectImage,
  mainEntityOfPage: { '@id': webpageId },
  isPartOf: { '@id': WEBSITE_ID },
  author: { '@id': PERSON_ID },
  creator: { '@id': PERSON_ID },
  keywords: project.technologies.join(', '),
  ...(project.links.demo ? { url: project.links.demo } : {}),
  ...(project.schemaType === 'WebApplication'
    ? {
        applicationCategory: 'BusinessApplication',
        operatingSystem: 'Web browser',
      }
    : {
        ...(project.links.github ? { codeRepository: project.links.github } : {}),
        programmingLanguage: project.lang,
        runtimePlatform,
      }),
};
---
<Layout
  lang={lang}
  route={{ page: 'project', project }}
  title={localized.seo.title}
  description={localized.seo.description}
  ogType="article"
  ogImage={localized.ogImage.src}
  ogImageAlt={localized.ogImage.alt}
  mainEntityId={projectId}
  jsonLd={[projectNode, breadcrumbNode]}>
  <ProjectPage lang={lang} project={project} />
</Layout>
