---
import Layout from '../../layouts/layout.astro';
import HomePage from '../../components/pages/homePage.astro';
import { useTranslations } from '../../i18n/utils';
import { recentCommitsPromise } from '../../data/githubActivity';

const lang = 'pl' as const;
const t = useTranslations(lang);

/**
 * Build-time GitHub fetch lives in `src/data/githubActivity.ts`, shared with
 * `index.astro`, and memoized at module scope so it runs exactly once per
 * build rather than once per locale.
 */
const recentCommits = await recentCommitsPromise;
---

<Layout
  lang={lang}
  route={{ page: 'home' }}
  title={t.meta.home.title}
  description={t.meta.home.description}
  ogType="profile"
  pageType="ProfilePage"
>
  <HomePage lang={lang} recentCommits={recentCommits} />
</Layout>
