---
import Layout from '../layouts/layout.astro';
import NotFoundPage from '../components/pages/notFoundPage.astro';
import { useTranslations } from '../i18n/utils';

/**
 * `lang="en"` here only sets the document's declared `<html lang>` and the
 * English `<title>`/description — Vercel serves this exact static file for
 * every unmatched path regardless of locale. `NotFoundPage` renders both
 * language blocks itself and swaps the visible one client-side; see that
 * component for why.
 */
const t = useTranslations('en');
---

<Layout
  lang="en"
  route={{ page: 'notFound' }}
  title={t.meta.notFound.title}
  description={t.meta.notFound.description}
  noindex
>
  <NotFoundPage />
</Layout>
